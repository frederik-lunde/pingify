{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["DOM","es2020"],
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",          // <== Output folder for compiled files
    "rootDir": "src"           // <== Source TypeScript files root
  }
}
