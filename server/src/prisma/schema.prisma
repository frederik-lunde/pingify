//schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  password     String
  name         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  websiteUsers WebsiteUser[] // Relation to the join table
  UserAlert    AlertUser[]
}

model Website {
  id          Int       @id @default(autoincrement())
  url         String    @unique // Unique URL to avoid duplicates
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastChecked DateTime?

  isActive          Boolean            @default(false) // Master switch for monitoring
  globalInterval    Int                @default(300) // Global check interval in seconds
  alerts            Alert[]
  monitoringResults MonitoringResult[]
  websiteUsers      WebsiteUser[] // Relation to the join table

  @@index([isActive])
}

// Join table for many-to-many relationship with user-specific settings
model WebsiteUser {
  id             Int      @id @default(autoincrement())
  userId         Int
  websiteId      Int
  name           String? // User's custom name for this website
  interval       Int? // User's preferred checking interval
  alertThreshold Int? // User's threshold for slow response alerts
  alertEnabled   Boolean  @default(false)
  notifyEmail    String? // User's email for notifications
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  website        Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([userId, websiteId]) // Ensures a user can only be associated with a website once
  @@index([userId])
  @@index([websiteId])
}

model MonitoringResult {
  id           Int      @id @default(autoincrement())
  websiteId    Int
  responseTime Int?
  isAvailable  Boolean
  statusCode   Int?
  errorMessage String?  @db.Text
  checkedAt    DateTime @default(now())
  website      Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
  @@index([checkedAt])
  @@index([isAvailable])
}

model Alert {
  id           Int         @id @default(autoincrement())
  websiteId    Int
  message      String
  type         String
  //isRead       Boolean     @default(false)  // For backward compatibility BURDE FJERNE
  isResolved   Boolean     @default(false)  // New field to track resolution
  resolvedAt   DateTime?   // Track when the alert was resolved
  createdAt    DateTime    @default(now())
  website      Website     @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  alertUsers   AlertUser[] // Relation to junction table

  @@index([websiteId])
  @@index([createdAt])
  @@index([type])
  //@@index([isRead])
  @@index([isResolved])
}

model AlertUser {
  id        Int      @id @default(autoincrement())
  userId    Int
  alertId   Int
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  alert     Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@unique([userId, alertId]) // A user can only have one record per alert
  @@index([userId])
  @@index([alertId])
  @@index([isRead])
}