// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id        String      @id @default(cuid()) // Changed: String, CUID
  email     String      @unique
  password  String
  name      String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  websiteUsers WebsiteUser[]
  Alert        Alert[]
}

model Website {
  id          Int       @id @default(autoincrement())
  url         String    @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastChecked DateTime?

  isActive          Boolean            @default(false)
  globalInterval    Int                @default(300)
  alerts            Alert[]
  monitoringResults MonitoringResult[]
  websiteUsers      WebsiteUser[]
  incidents         Incident[]

  @@index([isActive])
}

model WebsiteUser {
  id             Int      @id @default(autoincrement())
  userId         String   // Changed: String
  websiteId      Int
  name           String?
  interval       Int?
  alertThreshold Int?
  alertEnabled   Boolean  @default(false)
  notifyEmail    String?
  createdAt      DateTime @default(now())
  isPinned       Boolean  @default(false)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([userId, websiteId])
  @@index([userId])
  @@index([websiteId])
  @@map("website_users") // Optional: explicit table name
}

model MonitoringResult {
  id           Int      @id @default(autoincrement())
  websiteId    Int
  responseTime Int?
  isAvailable  Boolean
  statusCode   Int?
  errorMessage String?  @db.Text
  checkedAt    DateTime @default(now())

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  triggeredIncidents Incident[] @relation("TriggeringResult")
  confirmedIncidents Incident[] @relation("ConfirmingResult")
  resolvedIncidents  Incident[] @relation("ResolvingResult")

  @@index([websiteId])
  @@index([checkedAt])
  @@index([isAvailable])
  @@map("monitoring_results") // Optional: explicit table name
}

model Alert {
  id         Int       @id @default(autoincrement())
  websiteId  Int
  userId     String    // Changed: String
  message    String
  type       String
  createdAt  DateTime  @default(now())
  incidentId Int?

  website  Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  incident Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull) // Ensure onDelete is appropriate

  @@index([websiteId])
  @@index([userId])
  @@index([createdAt])
  @@index([type])
  @@index([incidentId])
}

model Incident {
  id                 Int       @id @default(autoincrement())
  websiteId          Int
  type               String
  startTime          DateTime
  endTime            DateTime?
  durationSeconds    Int?
  initialResultId    Int?
  confirmingResultId Int?
  resolvingResultId  Int?

  website          Website           @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  initialResult    MonitoringResult? @relation("TriggeringResult", fields: [initialResultId], references: [id], onDelete: SetNull)
  confirmingResult MonitoringResult? @relation("ConfirmingResult", fields: [confirmingResultId], references: [id], onDelete: SetNull)
  resolvingResult  MonitoringResult? @relation("ResolvingResult", fields: [resolvingResultId], references: [id], onDelete: SetNull)
  alerts           Alert[]

  @@index([websiteId])
  @@index([startTime])
  @@index([endTime])
  @@index([type])
  @@index([initialResultId])
  @@index([confirmingResultId])
  @@index([resolvingResultId])
}