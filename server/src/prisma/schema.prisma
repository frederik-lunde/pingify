// schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  password     String
  name         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  websiteUsers WebsiteUser[] // Relation to the join table
  Alert        Alert[]
}

model Website {
  id          Int       @id @default(autoincrement())
  url         String    @unique // Unique URL to avoid duplicates
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastChecked DateTime?

  isActive          Boolean            @default(false) // Master switch for monitoring
  globalInterval    Int                @default(300) // Global check interval in seconds
  alerts            Alert[]
  monitoringResults MonitoringResult[]
  websiteUsers      WebsiteUser[] // Relation to the join table
  incidents         Incident[] // Relation to incidents

  @@index([isActive])
}

// Join table for many-to-many relationship with user-specific settings
model WebsiteUser {
  id             Int      @id @default(autoincrement())
  userId         Int
  websiteId      Int
  name           String? // User's custom name for this website
  interval       Int? // User's preferred checking interval
  alertThreshold Int? // User's threshold for slow response alerts
  alertEnabled   Boolean  @default(false)
  notifyEmail    String? // User's email for notifications
  createdAt      DateTime @default(now())
  isPinned       Boolean  @default(false) // For pinning websites in the UI
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  website        Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([userId, websiteId]) // Ensures a user can only be associated with a website once
  @@index([userId])
  @@index([websiteId])
}

model MonitoringResult {
  id           Int      @id @default(autoincrement())
  websiteId    Int
  responseTime Int?
  isAvailable  Boolean
  statusCode   Int?
  errorMessage String?  @db.Text
  checkedAt    DateTime @default(now())
  website      Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  // Optional relations to incidents this result triggered, confirmed, or resolved
  triggeredIncidents Incident[] @relation("TriggeringResult")
  confirmedIncidents Incident[] @relation("ConfirmingResult")
  resolvedIncidents  Incident[] @relation("ResolvingResult")

  @@index([websiteId])
  @@index([checkedAt])
  @@index([isAvailable])
}

model Alert {
  id         Int       @id @default(autoincrement())
  websiteId  Int
  userId     Int
  message    String
  type       String // 'down' or 'slow' - Corresponds to Incident type
  createdAt  DateTime  @default(now())
  website    Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  incidentId Int?
  incident   Incident? @relation(fields: [incidentId], references: [id])

  @@index([websiteId])
  @@index([userId])
  @@index([createdAt])
  @@index([type])
  @@index([incidentId]) // Add if incidentId is added
}

// NEW: Incident Model
model Incident {
  id                 Int       @id @default(autoincrement())
  websiteId          Int
  type               String // 'down' or 'slow'
  startTime          DateTime // When the incident was confirmed
  endTime            DateTime? // When the incident was resolved
  durationSeconds    Int? // Calculated duration in seconds when resolved
  initialResultId    Int? // The monitoring result that *first* indicated the issue
  confirmingResultId Int? // The monitoring result from the recheck that *confirmed* the incident
  resolvingResultId  Int? // The monitoring result that confirmed recovery

  website          Website           @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  initialResult    MonitoringResult? @relation("TriggeringResult", fields: [initialResultId], references: [id], onDelete: SetNull)
  confirmingResult MonitoringResult? @relation("ConfirmingResult", fields: [confirmingResultId], references: [id], onDelete: SetNull)
  resolvingResult  MonitoringResult? @relation("ResolvingResult", fields: [resolvingResultId], references: [id], onDelete: SetNull)
  alerts           Alert[]

  @@index([websiteId])
  @@index([startTime])
  @@index([endTime])
  @@index([type])
  @@index([initialResultId])
  @@index([confirmingResultId])
  @@index([resolvingResultId])
}
