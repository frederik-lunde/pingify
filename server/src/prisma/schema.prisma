// Updated schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id            Int             @id @default(autoincrement())
  email         String          @unique
  password      String
  name          String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  websiteUsers  WebsiteUser[]   // Relation to the join table
}

model Website {
  id                Int                @id @default(autoincrement())
  name              String
  url               String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  interval          Int   
  lastChecked       DateTime?  
  isActive          Boolean            @default(true)
  alertThreshold    Int                @default(2000)
  alertEnabled      Boolean            @default(true)
  notifyEmail       String?
  alerts            Alert[]
  monitoringResults MonitoringResult[]
  websiteUsers      WebsiteUser[]      // Relation to the join table

  @@index([isActive])
}

// Join table for many-to-many relationship
model WebsiteUser {
  id          Int      @id @default(autoincrement())
  userId      Int
  websiteId   Int
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  website     Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([userId, websiteId]) // Ensures a user can only be associated with a website once
  @@index([userId])
  @@index([websiteId])
}

model MonitoringResult {
  id           Int      @id @default(autoincrement())
  websiteId    Int
  responseTime Int?
  isAvailable  Boolean
  statusCode   Int?
  errorMessage String?  @db.Text
  checkedAt    DateTime @default(now())
  website      Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
  @@index([checkedAt])
  @@index([isAvailable])
}

model Alert {
  id        Int      @id @default(autoincrement())
  websiteId Int
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  website   Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
  @@index([createdAt])
  @@index([type])
  @@index([isRead])
}